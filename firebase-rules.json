{
  "rules": {
    "operations": {
      "$opCode": {
        ".validate": "$opCode.matches(/^[A-Z0-9]{4,8}$/)",
        ".read": true,
        ".write": true,
        "meta": {
          "createdAt": { ".validate": "newData.isNumber() || newData.val() == now" },
          "lastActive": { ".validate": "newData.isNumber() || newData.val() == now" }
        },
        "participants": {
          "$uid": {
            ".validate": "$uid.matches(/^[a-zA-Z0-9_-]{6,40}$/)",
            "role": { ".validate": "newData.isString() && newData.val().matches(/^(rescuer|victim|command)$/)" },
            "nickname": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
            "accuracy": { ".validate": "!newData.exists() || newData.isNumber()" },
            "updatedAt": { ".validate": "newData.isNumber() || newData.val() == now" }
          }
        }
      }
    }
  }
}
